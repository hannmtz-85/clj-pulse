# Copy to `.env` (git-ignored) and adjust. Local development only: never reuse these values anywhere real.
# Variables are consumed by compose.yaml, the Keycloak realm import (${VAR}) and the apps (Aero #env).

# PostgreSQL (shared by Keycloak and HAPI FHIR)
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-me

# Keycloak bootstrap admin (temporary account, see Keycloak 26 docs)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Confidential client secrets, injected into the realm JSON on import
WEB_CLIENT_SECRET=change-me
SCHEDULER_CLIENT_SECRET=change-me
API_CLIENT_SECRET=change-me

# Password shared by every demo user in the realm
DEMO_USER_PASSWORD=change-me
