;; The build of the clinical workspace (ADR-0029). `bb spa` watches and serves it on 3000; `bb spa:build` makes the release in
;; target/release, which `bb spa:serve` serves with the policy of the real thing; `bb spa:test` runs the tests on Node.
{:deps {:aliases [:cljs]}

 ;; Development only. Any path that is not a file is the page, since the routes are paths (history mode).
 :dev-http {3000 {:roots ["public" "target/dev"]
                  :push-state/index "index.html"}}

 :builds
 {:app {:target :browser
        :output-dir "target/dev/js"
        :asset-path "/js"
        :modules {:main {:init-fn pulse.spa.core/init}}
        ;; Closure renames what it does not know: a property of JavaScript that is read by name must be told to it
        ;; (`^js`) or read as data, and the compiler says when it cannot tell (an `:infer-warning`). `bb spa:build` fails
        ;; on any warning, that one among them.
        :compiler-options {:infer-externs :auto}
        :release {:output-dir "target/release/js"
                  :module-hash-names true}}

  :test {:target :node-test
         :output-to "target/node-tests.js"
         :ns-regexp "-test$"
         :autorun false}}}
