{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        ;; What the pages are made of, and what they know of the clinic's own rules: both are `.cljc`, and they are
        ;; compiled to JavaScript for the browser (ADR-0029)
        pulse/fhir {:local/root "../../libs/fhir"}
        pulse/ui {:local/root "../../libs/ui"}
        ;; How a time, a number and a reading are written, which the portal writes alike (ADR-0029)
        pulse/view {:local/root "../../libs/view"}}
 :aliases
 {;; The browser build. shadow-cljs reads it through `:deps {:aliases [:cljs]}` in shadow-cljs.edn, and needs itself here
  ;; as well as in package.json (the two versions are the same). The server of the release (`pulse.spa.*` in `.clj`) is
  ;; started from the root `:dev` alias, which has the platform, and none of it is a dependency of the compiler. The
  ;; routing (reitit-frontend) came with the panel (step 5); the parameters of an address are read by our own malli schemas, which
  ;; never throw, so reitit-malli is not needed; `day8.re-frame/test` is here since the events were first tested through the effects
  ;; they ask for (step 4).
  ;; `test` and the helpers of the tests of `libs/ui` are on the path so that the tests of the workspace run on Node
  ;; (`bb spa:test`), the same `.cljc` that Kaocha runs on the JVM.
  :cljs {:extra-paths ["test"]
         :extra-deps {pulse/ui-test-support {:local/root "../../libs/ui/test-support"}
                      ;; the tests of the library that writes times and readings, which the browser must pass as the JVM does
                      pulse/view-test {:local/root "../../libs/view/test"}
                      ;; the history of the browser and the click on a link that stays in the workspace; the matching is reitit-core
                      metosin/reitit-frontend {:mvn/version "0.11.0"}
                      thheller/shadow-cljs {:mvn/version "3.5.7"}
                      reagent/reagent {:mvn/version "2.0.1"}
                      re-frame/re-frame {:mvn/version "1.4.7"}
                      day8.re-frame/test {:mvn/version "0.1.7"}
                      org.clojure/test.check {:mvn/version "1.1.3"}}}}}
