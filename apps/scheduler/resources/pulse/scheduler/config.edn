;; The scheduler as an Integrant system: one entry per component, and #ig/ref where a component
;; needs another. Read by pulse.platform.config (Aero) and checked by the schema in
;; pulse.scheduler.config before anything starts, so a mistake here fails at once and says what is
;; wrong.
;;
;; Profile, chosen with SCHEDULER_PROFILE (default dev); where a profile is not listed #profile
;; falls back to :default:
;;   dev   the real identity provider, on port 5000
;;   test  what the tests use
;;
;; Nothing here is secret: the scheduler only checks tokens against Keycloak's public keys.
{:pulse.scheduler/logging
 {:level #profile {:default #keyword #or [#env LOG_LEVEL "info"]
                   :test :warn}
  :format #keyword #or [#env LOG_FORMAT "text"]
  ;; Jetty's own messages are not ours to read at :info
  :ns-levels {"org.eclipse.jetty.*" :warn}}

 :pulse.scheduler/jwks
 {:uri #or [#env KEYCLOAK_JWKS_URI "http://localhost:8080/realms/pulse/protocol/openid-connect/certs"]}

 :pulse.scheduler/verifier
 {:jwks #ig/ref :pulse.scheduler/jwks
  ;; Keycloak reports its issuer from its configured hostname, whatever address it is reached
  ;; at, so this and the JWKS address above are separate settings (the Docker profile needs it)
  :issuer #or [#env KEYCLOAK_ISSUER "http://localhost:8080/realms/pulse"]
  ;; Only tokens issued for this service: one for the api is not accepted here (ADR-0020)
  :audience "pulse-scheduler"
  :algorithms ["RS256"]
  :leeway-s 30
  :token-type "Bearer"}

 ;; The scheduler's own access token, for the services it calls as a client (ADR-0021): a service
 ;; account of the confidential client pulse-scheduler. Nothing is asked of Keycloak until a token
 ;; is needed. The secret is the one Keycloak imported with the realm (SCHEDULER_CLIENT_SECRET in
 ;; .env, which is git-ignored); it is read as a #secret, which prints as #secret[REDACTED].
 :pulse.scheduler/token
 {:token-uri #or [#env KEYCLOAK_TOKEN_URI "http://localhost:8080/realms/pulse/protocol/openid-connect/token"]
  :client-id "pulse-scheduler"
  :client-secret #profile {:default #secret #env SCHEDULER_CLIENT_SECRET
                           :test #secret "test-secret"}
  ;; Renewed this long before it expires, or at half of its life if that is shorter
  :renew-before-ms 60000
  ;; After a failure, nobody asks again for this long
  :retry-delay-ms 5000
  :timeout-ms 5000
  :connect-timeout-ms 2000}

 ;; The api, where the rules engine reads the patients and their readings (ADR-0022), with the
 ;; scheduler's own token: the api lets the role rules-engine read them and nothing else. It is a
 ;; client of the api as any other, so the api checks the token as it checks every token.
 :pulse.scheduler/api
 {:base-url #or [#env API_BASE_URL "http://localhost:4000"]
  :token #ig/ref :pulse.scheduler/token
  ;; A request that takes longer is abandoned, and so is a connection that takes longer to make
  :timeout-ms 10000
  :connect-timeout-ms 3000}

 ;; The FHIR server, where the rules engine reads the conditions of a patient and writes the alerts
 ;; it raises (the api has no way to write an alert). The test profile has a server in memory.
 :pulse.scheduler/fhir
 #profile {:default {:kind :http
                     :base-url #or [#env FHIR_BASE_URL "http://localhost:8090/fhir"]
                     :timeout-ms 10000
                     :connect-timeout-ms 3000}
           :test {:kind :memory}}

 ;; The catalogue of jobs is built by pulse.scheduler.jobs from the components it needs and the
 ;; settings of each job
 :pulse.scheduler/jobs
 {:api #ig/ref :pulse.scheduler/api
  :fhir #ig/ref :pulse.scheduler/fhir
  ;; The rules of Annex C over the latest readings (ADR-0022). The shortest window of a rule is a
  ;; day, so every five minutes (SCHEDULER_EVALUATE_EVERY_MS=300000) is quick enough to alert while
  ;; it matters and of no weight to the api; the default is quicker, to see an alert appear within
  ;; a minute of a reading when running it locally. The tests switch the job off: they run it by hand.
  :evaluate-rules {:enabled? #profile {:default true
                                       :test false}
                   :schedule {:type :interval
                              :every-ms #long #or [#env SCHEDULER_EVALUATE_EVERY_MS 30000]}}

  ;; The devices of the demo cohort, simulated (ADR-0023): about 28 readings a minute, written to
  ;; FHIR, and an abnormal episode in turn, so that alerts appear. For development: off in the tests,
  ;; SCHEDULER_SIMULATOR=false switches it off, and the profile of a deployment must say false.
  :simulate-devices {:enabled? #profile {:default #boolean #or [#env SCHEDULER_SIMULATOR "true"]
                                         :test false}
                     :schedule {:type :interval :every-ms 15000}
                     :batch-size 20}}

 :pulse.scheduler/executor
 {:jobs #ig/ref :pulse.scheduler/jobs
  ;; How long a stop lets a running job finish before interrupting it
  :grace-ms 5000}

 :pulse.scheduler/handler
 {:logging #ig/ref :pulse.scheduler/logging ; only to start logging before everything else
  :verifier #ig/ref :pulse.scheduler/verifier
  :executor #ig/ref :pulse.scheduler/executor
  :token #ig/ref :pulse.scheduler/token
  ;; Readiness asks whether the api and FHIR, which the jobs need, answer
  :api #ig/ref :pulse.scheduler/api
  :fhir #ig/ref :pulse.scheduler/fhir
  :realm "pulse-scheduler"
  :quiet-paths #{"/healthz" "/readyz"}}

 :pulse.scheduler/server
 {:handler #ig/ref :pulse.scheduler/handler
  :host #or [#env SCHEDULER_HOST "127.0.0.1"]
  :port #profile {:default #long #or [#env SCHEDULER_PORT 5000]
                  :test 0}}}
