;; The api as an Integrant system: one entry per component, and #ig/ref where a component needs
;; another. Read by pulse.platform.config (Aero) and checked by the schema in pulse.api.config
;; before anything starts, so a mistake here fails at once and says what is wrong.
;;
;; Profile, chosen with API_PROFILE (default dev); where a profile is not listed #profile
;; falls back to :default:
;;   dev   the real HAPI FHIR server
;;   lite  no HAPI: an in-memory FHIR server loaded with the demo cohort, for machines short of RAM
;;   test  what the tests use
;;
;; Nothing here is secret: the api only checks tokens against Keycloak's public keys.
{:pulse.api/logging
 {:level #profile {:default #keyword #or [#env LOG_LEVEL "info"]
                   :test :warn}
  :format #keyword #or [#env LOG_FORMAT "text"]
  ;; Jetty's own messages are not ours to read at :info
  :ns-levels {"org.eclipse.jetty.*" :warn}}

 :pulse.api/jwks
 {:uri #or [#env KEYCLOAK_JWKS_URI "http://localhost:8080/realms/pulse/protocol/openid-connect/certs"]}

 :pulse.api/verifier
 {:jwks #ig/ref :pulse.api/jwks
  ;; Keycloak reports its issuer from its configured hostname, whatever address it is reached
  ;; at, so this and the JWKS address above are separate settings (the Docker profile needs it)
  :issuer #or [#env KEYCLOAK_ISSUER "http://localhost:8080/realms/pulse"]
  :audience "pulse-api"
  :algorithms ["RS256"]
  :leeway-s 30
  :token-type "Bearer"}

 ;; The api's own access token, for the one service it calls as a client: the scheduler (ADR-0025). A
 ;; service account of the confidential client pulse-api, whose token is for the scheduler. Nothing
 ;; is asked of Keycloak until a token is needed. The secret is the one Keycloak imported with the
 ;; realm (API_CLIENT_SECRET in .env, which is git-ignored; `bb env:init` adds it to an .env that
 ;; lacks it); it is read as a #secret, which prints as #secret[REDACTED].
 :pulse.api/token
 {:token-uri #or [#env KEYCLOAK_TOKEN_URI "http://localhost:8080/realms/pulse/protocol/openid-connect/token"]
  :client-id "pulse-api"
  :client-secret #profile {:default #secret #env API_CLIENT_SECRET
                           :test #secret "test-secret"}
  ;; Renewed this long before it expires, or at half of its life if that is shorter
  :renew-before-ms 60000
  ;; After a failure, nobody asks again for this long
  :retry-delay-ms 5000
  :timeout-ms 5000
  :connect-timeout-ms 2000}

 ;; The scheduler, which the administrator's list of jobs is asked of (ADR-0025). The address follows
 ;; the scheduler's port (SCHEDULER_PORT). A request that takes longer is abandoned and the caller gets
 ;; a 504; one that cannot be made, or is refused or fails, is a 502.
 :pulse.api/scheduler
 {:base-url #or [#env SCHEDULER_BASE_URL "http://localhost:5000"]
  :token #ig/ref :pulse.api/token
  :timeout-ms 5000
  :connect-timeout-ms 2000}

 :pulse.api/fhir
 #profile {:default {:kind :http
                     :base-url #or [#env FHIR_BASE_URL "http://localhost:8090/fhir"]
                     ;; A request that takes longer is abandoned and the caller gets a 504; so
                     ;; does a connection that takes longer to make (a refused one is a 502)
                     :timeout-ms 10000
                     :connect-timeout-ms 3000}
           :lite {:kind :memory}
           :test {:kind :memory}}

 :pulse.api/handler
 {:logging #ig/ref :pulse.api/logging ; only to start logging before everything else
  :verifier #ig/ref :pulse.api/verifier
  :fhir #ig/ref :pulse.api/fhir
  :scheduler #ig/ref :pulse.api/scheduler
  :realm "pulse-api"
  ;; The identity provider as a browser reaches it: the sign-in of Swagger UI goes there, and the
  ;; page of Swagger UI may call it (ADR-0017)
  :issuer #ref [:pulse.api/verifier :issuer]
  ;; The browser applications that may call the api from another origin (ADR-0018): exact origins,
  ;; separated by commas, never *. The clinical workspace (spa) is the only one so far; an empty
  ;; API_CORS_ORIGINS allows none.
  :cors {:allowed-origins #csv #or [#env API_CORS_ORIGINS "http://localhost:3000"]}
  :quiet-paths #{"/healthz" "/readyz"}
  ;; The summary of a patient asks FHIR about a dozen things at once and waits this long for all
  ;; of them: what is late is left out and named in the answer (ADR-0013)
  :summary-timeout-ms 4000}

 :pulse.api/server
 {:handler #ig/ref :pulse.api/handler
  :host #or [#env API_HOST "127.0.0.1"]
  :port #profile {:default #long #or [#env API_PORT 4000]
                  :test 0}}}
