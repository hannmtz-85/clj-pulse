{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        pulse/fhir {:local/root "../../libs/fhir"}
        pulse/platform {:local/root "../../libs/platform"}
        ;; HTTP server and routing: routes are data (Reitit), bodies are negotiated and coerced
        ;; with muuntaja and malli.
        ring/ring-core {:mvn/version "1.15.5"}
        ring/ring-jetty-adapter {:mvn/version "1.15.5"}
        metosin/reitit-ring {:mvn/version "0.11.0"}
        metosin/reitit-malli {:mvn/version "0.11.0"}
        metosin/reitit-middleware {:mvn/version "0.11.0"}
        ;; The API description (OpenAPI 3) is generated from the same route data, and Swagger UI,
        ;; packaged as a jar, is how it is read and tried out (ADR-0017). The OpenAPI module is
        ;; published under the group `fi.metosin`; the Swagger UI one, under `metosin`.
        fi.metosin/reitit-openapi {:mvn/version "0.11.0"}
        metosin/reitit-swagger-ui {:mvn/version "0.11.0"}
        ;; Pinned above what reitit-swagger-ui pulls (5.32.11): that release of the jar lacks
        ;; oauth2-redirect.js, the page the sign-in comes back to.
        metosin/ring-swagger-ui {:mvn/version "5.33.0"}
        metosin/muuntaja {:mvn/version "0.6.12"}}}
