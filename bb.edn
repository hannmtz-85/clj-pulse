{:paths ["tools" "libs/fhir/src" "libs/fhir/resources" "libs/ui/src" "design/src"]
 :deps {metosin/malli {:mvn/version "0.20.3"}}
 :tasks
 {:requires ([babashka.process :refer [shell]])

  doctor {:doc "Check that this machine can build and run the project"
          :requires ([doctor])
          :task (doctor/-main)}

  ;; --- code quality -------------------------------------------------------
  test {:doc "Run the JVM unit tests (Kaocha); extra args are passed through"
        :task (apply shell "clojure" "-M:test" "--skip-meta" ":integration" *command-line-args*)}

  test:it {:doc "Run the integration tests against the running stack (needs `bb up`)"
           :task (apply shell "clojure" "-M:test" "--focus-meta" ":integration" *command-line-args*)}

  lint {:doc "Lint all sources with clj-kondo"
        :task (shell "clojure" "-M:lint")}

  fmt {:doc "Reformat all sources with cljfmt"
       :task (shell "clojure" "-M:fmt" "fix")}

  fmt:check {:doc "Fail if any source is not formatted (used by CI)"
             :task (shell "clojure" "-M:fmt" "check")}

  check {:doc "Everything CI runs: format check, lint, realm and design checks, and tests"
         :task (do (run 'fmt:check) (run 'lint) (run 'realm:check) (run 'design:check) (run 'test))}

  ;; --- the design system (ADR-0026) ---------------------------------------
  design:theme {:doc "Write design/theme.css from design/tokens.edn"
                :requires ([design])
                :task (design/write-theme!)}

  design:check {:doc "Fail if design/theme.css is stale or a pair of colours is below its contrast"
                :requires ([design])
                :task (design/check!)}

  design:contrast {:doc "Print the contrast ratio of every pair of colours of every palette"
                   :requires ([design])
                   :task (design/print-contrast)}

  design:icons {:doc "Write libs/ui/src/pulse/ui/icons.cljc from the Lucide icons listed in design/icons.edn (needs `npm ci` in design/)"
                :requires ([pulse.design.icons :as icons])
                :task (icons/generate!)}

  design:fonts {:doc "Copy the Inter font files from the npm package to design/fonts, where they are committed (needs `npm ci` in design/)"
                :requires ([pulse.design.build :as build])
                :task (build/install-fonts!)}

  design:css {:doc "Write design/theme.css and compile design/dist/pulse.css with Tailwind CSS (needs `npm ci` in design/)"
              :depends [design:theme]
              :task (shell {:dir "design"} "npm" "run" "css")}

  design:keycloak {:doc "Write the login theme of Keycloak (templates, messages, icon, fonts) into infra/keycloak/themes/pulse/login and compile its stylesheet (needs `npm ci` in design/)"
                   :depends [design:theme]
                   :requires ([pulse.design.keycloak :as keycloak])
                   :task (do (keycloak/write!)
                             (shell {:dir "design"} "npm" "run" "css:keycloak"))}

  design:build {:doc "Make the mock-ups in design/dist from the components and the synthetic cohort (then open design/dist/index.html)"
                :depends [design:css]
                :requires ([pulse.design.build :as build])
                :task (build/build!)}

  design:shots {:doc "Take screenshots of the mock-ups into design/dist/shots with headless Chrome or Edge: bb design:shots [page-prefix ...]"
                :requires ([pulse.design.shots :as shots])
                :task (shots/take! *command-line-args*)}

  ;; --- infrastructure -----------------------------------------------------
  env:init {:doc "Create .env from .env.example with random local secrets (never overwrites)"
            :requires ([env])
            :task (env/init!)}

  realm:build {:doc "Generate the Keycloak realm JSON from tools/realm.clj"
               :requires ([realm])
               :task (realm/build!)}

  realm:check {:doc "Fail if the committed realm JSON is stale"
               :requires ([realm])
               :task (realm/check!)}

  realm:smoke {:doc "Sign in as every demo user, through the Swagger UI client and as the service accounts, and verify their token claims (needs `bb up`)"
               :requires ([kc])
               :task (kc/smoke)}

  token {:doc "Print an access token: bb token <username | scheduler | api> [pulse-docs] (needs `bb up`)"
         :requires ([kc])
         :task (kc/print-token (first *command-line-args*) (second *command-line-args*))}

  seed {:doc "Load the demo cohort into HAPI FHIR (idempotent; needs `bb up`)"
        :requires ([seed])
        :task (seed/seed!)}

  seed:validate {:doc "Validate the demo cohort with HAPI's $validate: a representative sample, or everything with --all (needs `bb up`)"
                 :requires ([seed])
                 :task (apply seed/validate! *command-line-args*)}

  up {:doc "Start PostgreSQL, Keycloak and HAPI FHIR and wait until they are ready"
      :depends [env:init realm:build]
      :requires ([stack])
      :task (do (shell "docker" "compose" "up" "-d" "--wait" "--wait-timeout" "420")
                (stack/wait-http! "HAPI FHIR" "http://localhost:8090/actuator/health" 300))}

  down {:doc "Stop the stack (data is kept)"
        :task (shell "docker" "compose" "down")}

  reset {:doc "DESTROY the stack's data (volumes) and start again from a clean state"
         :depends [env:init]
         :task (do (shell "docker" "compose" "down" "--volumes")
                   (run 'up))}

  logs {:doc "Follow the logs; optionally of one service: bb logs keycloak"
        :task (apply shell "docker" "compose" "logs" "--follow" "--tail" "100" *command-line-args*)}

  ps {:doc "Show the state of the stack"
      :task (shell "docker" "compose" "ps")}

  ;; --- the apps ------------------------------------------------------------
  dev {:doc "Run the api and the scheduler in one JVM: bb dev [dev | lite]. `lite` uses an in-memory FHIR server instead of HAPI (Keycloak is still needed: bb up). The scheduler simulates devices (SCHEDULER_SIMULATOR=false stops that) and sends the reminders of appointments (SCHEDULER_REMINDERS=false stops that)"
       :task (apply shell "clojure" "-M:dev" "-m" "pulse.dev" *command-line-args*)}

  scheduler {:doc "Run the scheduler alone on 127.0.0.1:5000: bb scheduler [dev | test]. It gets its client secret from .env (needs `bb up`)"
             :requires ([env])
             :task (apply shell {:extra-env (env/vars ["SCHEDULER_CLIENT_SECRET"])}
                          "clojure" "-M:dev" "-m" "pulse.scheduler.main" *command-line-args*)}}}
