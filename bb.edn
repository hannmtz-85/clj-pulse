{:paths ["tools" "libs/fhir/src" "libs/fhir/resources" "libs/platform/src" "libs/ui/src" "libs/view/src" "apps/web/src" "apps/spa/src" "design/src"]
 :deps {metosin/malli {:mvn/version "0.20.3"}}
 :tasks
 {:requires ([babashka.process :refer [shell]])

  doctor {:doc "Check that this machine can build and run the project"
          :requires ([doctor])
          :task (doctor/-main)}

  ;; --- code quality -------------------------------------------------------
  test {:doc "Run the JVM unit tests (Kaocha); extra args are passed through"
        :task (apply shell "clojure" "-M:test" "--skip-meta" ":integration" *command-line-args*)}

  test:it {:doc "Run the integration tests against the running stack (needs `bb up`)"
           :task (apply shell "clojure" "-M:test" "--focus-meta" ":integration" *command-line-args*)}

  lint {:doc "Lint all sources with clj-kondo"
        :task (shell "clojure" "-M:lint")}

  fmt {:doc "Reformat all sources with cljfmt"
       :task (shell "clojure" "-M:fmt" "fix")}

  fmt:check {:doc "Fail if any source is not formatted (used by CI)"
             :task (shell "clojure" "-M:fmt" "check")}

  check {:doc "Everything CI runs: format check, lint, realm and design checks, the tests on the JVM and the tests of the clinical workspace on Node"
         :task (do (run 'fmt:check) (run 'lint) (run 'realm:check) (run 'design:check) (run 'test) (run 'spa:test))}

  ;; --- the design system (ADR-0026) ---------------------------------------
  design:theme {:doc "Write design/theme.css from design/tokens.edn"
                :requires ([design])
                :task (design/write-theme!)}

  design:check {:doc "Fail if design/theme.css is stale or a pair of colours is below its contrast"
                :requires ([design])
                :task (design/check!)}

  design:contrast {:doc "Print the contrast ratio of every pair of colours of every palette"
                   :requires ([design])
                   :task (design/print-contrast)}

  design:icons {:doc "Write libs/ui/src/pulse/ui/icons.cljc from the Lucide icons listed in design/icons.edn (needs `npm ci` in design/)"
                :requires ([pulse.design.icons :as icons])
                :task (icons/generate!)}

  design:fonts {:doc "Copy the Inter font files from the npm package to design/fonts, where they are committed (needs `npm ci` in design/)"
                :requires ([pulse.design.build :as build])
                :task (build/install-fonts!)}

  design:css {:doc "Write design/theme.css and compile design/dist/pulse.css with Tailwind CSS (needs `npm ci` in design/)"
              :depends [design:theme]
              :task (shell {:dir "design"} "npm" "run" "css")}

  design:keycloak {:doc "Write the login theme of Keycloak (templates, messages, icon, fonts) into infra/keycloak/themes/pulse/login and compile its stylesheet (needs `npm ci` in design/)"
                   :depends [design:theme]
                   :requires ([pulse.design.keycloak :as keycloak])
                   :task (do (keycloak/write!)
                             (shell {:dir "design"} "npm" "run" "css:keycloak"))}

  design:web {:doc "Write the static files of the patient portal into apps/web/resources/public (the stylesheet, the font, the icon and htmx) and compile its stylesheet (needs `npm ci` in design/)"
              :depends [design:theme]
              :requires ([pulse.design.web :as web])
              :task (do (web/write!)
                        (shell {:dir "design"} "npm" "run" "css:web"))}

  design:spa {:doc "Write the static files of the clinical workspace into apps/spa/public (the page, the font and the icon) and compile its stylesheet (needs `npm ci` in design/)"
              :depends [design:theme]
              :requires ([pulse.design.spa :as spa])
              :task (do (spa/write!)
                        (shell {:dir "design"} "npm" "run" "css:spa"))}

  design:build {:doc "Make the mock-ups in design/dist from the components and the synthetic cohort (then open design/dist/index.html)"
                :depends [design:css]
                :requires ([pulse.design.build :as build])
                :task (build/build!)}

  design:shots {:doc "Take screenshots of the mock-ups into design/dist/shots with headless Chrome or Edge: bb design:shots [page-prefix ...]"
                :requires ([pulse.design.shots :as shots])
                :task (shots/take! *command-line-args*)}

  ;; --- infrastructure -----------------------------------------------------
  env:init {:doc "Create .env from .env.example with random local secrets (never overwrites)"
            :requires ([env])
            :task (env/init!)}

  realm:build {:doc "Generate the Keycloak realm JSON from tools/realm.clj"
               :requires ([realm])
               :task (realm/build!)}

  realm:check {:doc "Fail if the committed realm JSON is stale"
               :requires ([realm])
               :task (realm/check!)}

  realm:smoke {:doc "Sign in as every demo user, through the Swagger UI client and as the service accounts, and verify their token claims (needs `bb up`)"
               :requires ([kc])
               :task (kc/smoke)}

  token {:doc "Print an access token: bb token <username | scheduler | api> [pulse-docs] (needs `bb up`)"
         :requires ([kc])
         :task (kc/print-token (first *command-line-args*) (second *command-line-args*))}

  seed {:doc "Load the demo cohort into HAPI FHIR (idempotent; needs `bb up`)"
        :requires ([seed])
        :task (seed/seed!)}

  seed:validate {:doc "Validate the demo cohort with HAPI's $validate: a representative sample, or everything with --all (needs `bb up`)"
                 :requires ([seed])
                 :task (apply seed/validate! *command-line-args*)}

  up {:doc "Start PostgreSQL, Keycloak and HAPI FHIR and wait until they are ready"
      :depends [env:init realm:build]
      :requires ([stack])
      :task (do (shell "docker" "compose" "up" "-d" "--wait" "--wait-timeout" "420")
                (stack/wait-http! "HAPI FHIR" "http://localhost:8090/actuator/health" 300))}

  down {:doc "Stop the stack and the applications, if they are up (data is kept)"
        :task (shell "docker" "compose" "--profile" "*" "down")}

  reset {:doc "DESTROY the stack's data (volumes) and start again from a clean state"
         :depends [env:init]
         :task (do (shell "docker" "compose" "--profile" "*" "down" "--volumes")
                   (run 'up))}

  logs {:doc "Follow the logs; optionally of one service, an application among them: bb logs keycloak"
        :task (apply shell "docker" "compose" "--profile" "*" "logs" "--follow" "--tail" "100" *command-line-args*)}

  ps {:doc "Show the state of the stack and of the applications"
      :task (shell "docker" "compose" "--profile" "*" "ps")}

  ;; --- the apps ------------------------------------------------------------
  dev {:doc "Run the api, the scheduler and the patient portal in one JVM: bb dev [dev | lite]. `lite` uses an in-memory FHIR server instead of HAPI (Keycloak is still needed: bb up). The scheduler simulates devices (SCHEDULER_SIMULATOR=false stops that) and sends the reminders of appointments (SCHEDULER_REMINDERS=false stops that)"
       :task (apply shell "clojure" "-M:dev" "-m" "pulse.dev" *command-line-args*)}

  scheduler {:doc "Run the scheduler alone on 127.0.0.1:5000: bb scheduler [dev | test]. It gets its client secret from .env (needs `bb up`)"
             :requires ([env])
             :task (apply shell {:extra-env (env/vars ["SCHEDULER_CLIENT_SECRET"])}
                          "clojure" "-M:dev" "-m" "pulse.scheduler.main" *command-line-args*)}

  web {:doc "Run the patient portal alone on 127.0.0.1:3300: bb web [dev | test]. It gets its client secret from .env and asks Keycloak and the api (bb up; bb dev runs the api)"
       :requires ([env])
       :task (apply shell {:extra-env (env/vars ["WEB_CLIENT_SECRET"])}
                    "clojure" "-M:dev" "-m" "pulse.web.main" *command-line-args*)}

  web:journey {:doc "The acceptance of the patient portal in headless Chrome or Edge with the real Keycloak: bb web:journey [--portal url] [--keycloak url] [--shots dir]. Needs bb up and the portal on 3300 (bb dev lite leaves nothing behind)"
               :task (apply shell "node" "apps/web/journey.mjs" *command-line-args*)}

  spa {:doc "Watch and serve the clinical workspace on localhost:3000 with hot reload (shadow-cljs; needs `npm ci` in apps/spa, and the stack and `bb dev` for the sign-in and the api)"
       :requires ([spa])
       :task (spa/dev!)}

  spa:build {:doc "Make the release of the clinical workspace in apps/spa/target/release (optimized, with the hash of the script in its name); a build with any warning fails"
             :requires ([spa])
             :task (spa/release!)}

  spa:serve {:doc "Serve the release of the clinical workspace on 127.0.0.1:3000 with its Content-Security-Policy: bb spa:serve [dev | test] (run bb spa:build first)"
             :task (apply shell "clojure" "-M:dev" "-m" "pulse.spa.main" *command-line-args*)}

  spa:journey {:doc "The acceptance of the clinical workspace in headless Chrome or Edge, with the real Keycloak and api: bb spa:journey [--no-build] [--shots dir] [--only sections]. Makes the release, starts the api (bb dev lite) and the server of the release itself, and stops them: it needs bb up (Keycloak) and the ports 3000, 3300, 4000 and 5000 free"
               :requires ([spa-journey])
               :task (spa-journey/run! *command-line-args*)}

  spa:test {:doc "Run the tests of the clinical workspace on Node (shadow-cljs :node-test); a build with any warning fails"
            :requires ([spa])
            :task (spa/test!)}

  ;; --- packaging (ADR-0030) -------------------------------------------------
  spa:nginx {:doc "Write infra/spa/nginx.conf, the configuration of nginx for the release of the workspace, from the headers and the names of its Ring server: bb spa:nginx [check] [--api-base-url address] [--issuer address] [--base-url address]. `check` only compares"
             :task (apply shell "clojure" "-M:dev" "-m" "pulse.spa.nginx" *command-line-args*)}

  apps {:doc "Build the images of the four applications, one at a time, and start them with the infrastructure (the profile apps, ADR-0030): the workspace on 3000, the portal on 3300 and the api on 4000, with nothing else on those ports. The first build takes several minutes; a change in one app builds only that one"
        :depends [env:init realm:build]
        :task (do (doseq [service ["api" "scheduler" "web" "spa"]]
                    (shell "docker" "compose" "--profile" "apps" "build" service))
                  (shell "docker" "compose" "--profile" "apps" "up" "-d" "--wait" "--wait-timeout" "420"))}

  smoke {:doc "Ask the four applications in their containers what only they can answer: healthy and not killed, the issuer of a token asked at the back channel, nginx against the table of requests, the scheduler at work and, in a real browser, a patient and a practitioner signing in (ADR-0030): bb smoke [--timeout-seconds N] [--no-browser]. Needs bb up, bb seed and bb apps"
         :requires ([smoke])
         :task (smoke/run! *command-line-args*)}

  build {:doc "Make the jars of the JVM apps in target/, compiled ahead of time: bb build [api | scheduler | web ...]; all three when none is named. Each takes a few minutes. Run one with java -jar target/api.jar -m pulse.api.main"
         :requires ([build-plan])
         :task (doseq [app (build-plan/parse-apps *command-line-args*)]
                 (shell "clojure" "-T:build" "uber" ":app" (str ":" app)))}}}
