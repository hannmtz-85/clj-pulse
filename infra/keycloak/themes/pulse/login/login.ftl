<#import "template.ftl" as layout>
<@layout.registrationLayout displayMessage=(!messagesPerField.existsError('username','password')) displayInfo=(realm.password); section><#if section = "header">${msg("loginAccountTitle")}<#elseif section = "subtitle"><#if (client.name)?has_content>${msg("loginSubtitle", client.name)}</#if><#elseif section = "form"><#if realm.password><form action="${url.loginAction}" class="flex flex-col gap-5" id="kc-form-login" method="post" onsubmit="login.disabled = true; return true;"><#if messagesPerField.existsError('username','password')><div class="relative grid grid-cols-[auto_1fr] items-start gap-x-3 gap-y-3 overflow-hidden rounded-box border p-4 pl-5 border-tone-critical-edge bg-tone-critical-soft text-tone-critical-ink" role="alert"><span aria-hidden="true" class="absolute inset-y-0 left-0 w-1 bg-tone-critical-edge"></span><svg aria-hidden="true" class="shrink-0 mt-0.5 text-tone-critical-edge" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><path d="M12 16h.01"></path><path d="M12 8v4"></path><path d="M15.312 2a2 2 0 0 1 1.414.586l4.688 4.688A2 2 0 0 1 22 8.688v6.624a2 2 0 0 1-.586 1.414l-4.688 4.688a2 2 0 0 1-1.414.586H8.688a2 2 0 0 1-1.414-.586l-4.688-4.688A2 2 0 0 1 2 15.312V8.688a2 2 0 0 1 .586-1.414l4.688-4.688A2 2 0 0 1 8.688 2z"></path></svg><div class="min-w-0"><p class="font-semibold">${kcSanitize(messagesPerField.getFirstError('username','password'))?no_esc}</p><div class="text-sm">${msg("loginErrorHint")}</div></div></div></#if><#if !usernameHidden??><#if messagesPerField.existsError('username','password')><div class="flex flex-col gap-1.5"><label class="text-sm font-medium" for="username"><#if !realm.loginWithEmailAllowed>${msg("username")}<#elseif !realm.registrationEmailAsUsername>${msg("usernameOrEmail")}<#else>${msg("email")}</#if></label><input aria-invalid="true" autocomplete="username" class="input w-full input-error" dir="ltr" id="username" name="username" type="text" value="${login.username!}"></div><#else><div class="flex flex-col gap-1.5"><label class="text-sm font-medium" for="username"><#if !realm.loginWithEmailAllowed>${msg("username")}<#elseif !realm.registrationEmailAsUsername>${msg("usernameOrEmail")}<#else>${msg("email")}</#if></label><input autocomplete="username" autofocus class="input w-full" dir="ltr" id="username" name="username" type="text" value="${login.username!}"></div></#if></#if><#if messagesPerField.existsError('username','password')><div class="flex flex-col gap-1.5"><label class="text-sm font-medium" for="password">${msg("password")}</label><input aria-invalid="true" autocomplete="current-password" autofocus class="input w-full input-error" id="password" name="password" type="password"></div><#else><#if usernameHidden??><div class="flex flex-col gap-1.5"><label class="text-sm font-medium" for="password">${msg("password")}</label><input autocomplete="current-password" autofocus class="input w-full" id="password" name="password" type="password"></div><#else><div class="flex flex-col gap-1.5"><label class="text-sm font-medium" for="password">${msg("password")}</label><input autocomplete="current-password" class="input w-full" id="password" name="password" type="password"></div></#if></#if><#if (realm.rememberMe && !usernameHidden??) || realm.resetPasswordAllowed><div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2"><#if realm.rememberMe && !usernameHidden??><#if login.rememberMe??><div class="flex items-start gap-3"><input checked class="checkbox checkbox-primary" id="rememberMe" name="rememberMe" type="checkbox"><div class="flex flex-col"><label class="text-sm leading-6 font-medium" for="rememberMe">${msg("rememberMe")}</label></div></div><#else><div class="flex items-start gap-3"><input class="checkbox checkbox-primary" id="rememberMe" name="rememberMe" type="checkbox"><div class="flex flex-col"><label class="text-sm leading-6 font-medium" for="rememberMe">${msg("rememberMe")}</label></div></div></#if></#if><#if realm.resetPasswordAllowed><a class="link link-primary text-sm font-medium" href="${url.loginResetCredentialsUrl}">${msg("doForgotPassword")}</a></#if></div></#if><input type="hidden" id="id-hidden-input" name="credentialId" <#if auth.selectedCredential?has_content>value="${auth.selectedCredential}"</#if>/><button class="btn btn-primary btn-lg btn-block" id="kc-login" name="login" type="submit">${msg("doLogIn")}</button></form></#if><#elseif section = "info"><#if realm.password><#if realm.password && realm.registrationAllowed && !registrationDisabled??><span>${msg("noAccount")} <a class="link link-primary font-medium" href="${url.registrationUrl}">${msg("doRegister")}</a></span><#else><span>${msg("noAccountHint")}</span></#if></#if><#elseif section = "socialProviders"><#if realm.password && social?? && social.providers?has_content><div class="mt-6" id="kc-social-providers"><h2 class="mb-3 text-sm font-semibold text-muted">${msg("identity-provider-login-label")}</h2><ul class="flex flex-col gap-2"><#list social.providers as p><li><a class="btn btn-outline btn-primary btn-block" href="${p.loginUrl}" id="social-${p.alias}">${p.displayName!}</a></li></#list></ul></div></#if></#if></@layout.registrationLayout>
