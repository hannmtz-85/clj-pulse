<#macro registrationLayout bodyClass="" displayInfo=false displayMessage=true displayRequiredFields=false>
<!DOCTYPE html>
<html<#if realm.internationalizationEnabled> lang="${locale.currentLanguageTag}" dir="${(locale.rtl)?then('rtl','ltr')}"<#else> lang="en"</#if>><head><meta charset="utf-8"><meta content="width=device-width, initial-scale=1" name="viewport"><meta content="light dark" name="color-scheme"><meta content="noindex, nofollow" name="robots"><title>${msg("loginTitle", (realm.displayName!''))}</title><link href="${url.resourcesPath}/img/favicon.svg" rel="icon" type="image/svg+xml"><link href="${url.resourcesPath}/pulse.css" rel="stylesheet"><script type="importmap">{"imports":{"rfc4648":"${url.resourcesCommonPath}/vendor/rfc4648/rfc4648.js"}}</script><#if scripts??><#list scripts as script><script src="${script}" type="text/javascript"></script></#list></#if><script type="module">import { checkCookiesAndSetTimer } from "${url.resourcesPath}/js/authChecker.js"; checkCookiesAndSetTimer("${url.ssoLoginInOtherTabsUrl?no_esc}");</script></head><body class="min-h-screen bg-base-200 text-base-content antialiased"><div class="grid min-h-screen place-items-center bg-base-200 px-4 py-10"><a class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-field focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-content" href="#main">Skip to the content</a><main class="w-full max-w-md" id="main"><div class="mb-6 flex justify-center"><span class="inline-flex items-center gap-2"><span class="grid size-8 shrink-0 place-items-center rounded-field bg-primary text-primary-content"><svg aria-hidden="true" class="shrink-0" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"></path><path d="M3.22 13H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"></path></svg></span><span class="text-lg font-semibold tracking-tight">Pulse</span></span></div><div class="rounded-box border border-base-300 bg-base-100 p-6 shadow-raised sm:p-8"><h1 class="text-2xl font-semibold tracking-tight" id="kc-page-title"><#nested "header"></h1><#local subtitle><#nested "subtitle"></#local><#if subtitle?has_content><p class="mt-1 text-base text-muted">${subtitle}</p></#if><#if displayRequiredFields><p class="mt-1 text-sm text-muted"><span aria-hidden="true">*</span> ${msg("requiredFields")}</p></#if><#if auth?has_content && auth.showUsername() && !auth.showResetCredentials()><#nested "show-username"><p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm" id="kc-username"><span class="font-medium" id="kc-attempted-username">${auth.attemptedUsername}</span><a class="link link-primary" href="${url.loginRestartFlowUrl}" id="reset-login">${msg("restartLoginTooltip")}</a></p></#if><div class="mt-6 empty:mt-0" id="kc-content"><#if displayMessage && message?has_content && (message.type != 'warning' || !isAppInitiatedAction??)><#if message.type = 'error'><div class="relative grid grid-cols-[auto_1fr] items-start gap-x-3 gap-y-3 overflow-hidden rounded-box border p-4 pl-5 border-tone-critical-edge bg-tone-critical-soft text-tone-critical-ink" role="alert"><span aria-hidden="true" class="absolute inset-y-0 left-0 w-1 bg-tone-critical-edge"></span><svg aria-hidden="true" class="shrink-0 mt-0.5 text-tone-critical-edge" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><path d="M12 16h.01"></path><path d="M12 8v4"></path><path d="M15.312 2a2 2 0 0 1 1.414.586l4.688 4.688A2 2 0 0 1 22 8.688v6.624a2 2 0 0 1-.586 1.414l-4.688 4.688a2 2 0 0 1-1.414.586H8.688a2 2 0 0 1-1.414-.586l-4.688-4.688A2 2 0 0 1 2 15.312V8.688a2 2 0 0 1 .586-1.414l4.688-4.688A2 2 0 0 1 8.688 2z"></path></svg><div class="min-w-0"><p class="font-semibold">${kcSanitize(message.summary)?no_esc}</p></div></div><#elseif message.type = 'warning'><div class="relative grid grid-cols-[auto_1fr] items-start gap-x-3 gap-y-3 overflow-hidden rounded-box border p-4 pl-5 border-tone-high-edge bg-tone-high-soft text-tone-high-ink" role="alert"><span aria-hidden="true" class="absolute inset-y-0 left-0 w-1 bg-tone-high-edge"></span><svg aria-hidden="true" class="shrink-0 mt-0.5 text-tone-high-edge" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg><div class="min-w-0"><p class="font-semibold">${kcSanitize(message.summary)?no_esc}</p></div></div><#elseif message.type = 'success'><div class="relative grid grid-cols-[auto_1fr] items-start gap-x-3 gap-y-3 overflow-hidden rounded-box border p-4 pl-5 border-tone-normal-edge bg-tone-normal-soft text-tone-normal-ink" role="alert"><span aria-hidden="true" class="absolute inset-y-0 left-0 w-1 bg-tone-normal-edge"></span><svg aria-hidden="true" class="shrink-0 mt-0.5 text-tone-normal-edge" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><div class="min-w-0"><p class="font-semibold">${kcSanitize(message.summary)?no_esc}</p></div></div><#else><div class="relative grid grid-cols-[auto_1fr] items-start gap-x-3 gap-y-3 overflow-hidden rounded-box border p-4 pl-5 border-tone-info-edge bg-tone-info-soft text-tone-info-ink" role="alert"><span aria-hidden="true" class="absolute inset-y-0 left-0 w-1 bg-tone-info-edge"></span><svg aria-hidden="true" class="shrink-0 mt-0.5 text-tone-info-edge" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><div class="min-w-0"><p class="font-semibold">${kcSanitize(message.summary)?no_esc}</p></div></div></#if></#if><#nested "form"><#if auth?has_content && auth.showTryAnotherWayLink()><form action="${url.loginAction}" class="mt-4" id="kc-select-try-another-way-form" method="post"><input name="tryAnotherWay" type="hidden" value="on"><a class="link link-primary text-sm font-medium" href="#" id="try-another-way" onclick="document.forms[&apos;kc-select-try-another-way-form&apos;].submit(); return false;">${msg("doTryAnotherWay")}</a></form></#if><#nested "socialProviders"><#if displayInfo><div class="mt-6 text-center text-sm text-muted" id="kc-info"><#nested "info"></div></#if></div></div><p class="mt-6 text-center text-xs text-muted">${msg("demoNotice")}</p></main></div></body></html>
</#macro>
