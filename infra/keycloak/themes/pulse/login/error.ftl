<#import "template.ftl" as layout>
<@layout.registrationLayout displayMessage=(false); section><#if section = "header">${kcSanitize(msg("errorTitle"))?no_esc}<#elseif section = "form"><div class="flex flex-col gap-5" id="kc-error-message"><div class="relative grid grid-cols-[auto_1fr] items-start gap-x-3 gap-y-3 overflow-hidden rounded-box border p-4 pl-5 border-tone-critical-edge bg-tone-critical-soft text-tone-critical-ink" role="alert"><span aria-hidden="true" class="absolute inset-y-0 left-0 w-1 bg-tone-critical-edge"></span><svg aria-hidden="true" class="shrink-0 mt-0.5 text-tone-critical-edge" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><path d="M12 16h.01"></path><path d="M12 8v4"></path><path d="M15.312 2a2 2 0 0 1 1.414.586l4.688 4.688A2 2 0 0 1 22 8.688v6.624a2 2 0 0 1-.586 1.414l-4.688 4.688a2 2 0 0 1-1.414.586H8.688a2 2 0 0 1-1.414-.586l-4.688-4.688A2 2 0 0 1 2 15.312V8.688a2 2 0 0 1 .586-1.414l4.688-4.688A2 2 0 0 1 8.688 2z"></path></svg><div class="min-w-0"><p class="font-semibold">${kcSanitize(message.summary)?no_esc}</p></div></div><#if !skipLink?? && client?? && client.baseUrl?has_content><a class="btn btn-outline btn-primary btn-lg btn-block" href="${client.baseUrl}" id="backToApplication">${kcSanitize(msg("backToApplication"))?no_esc}</a></#if></div></#if></@layout.registrationLayout>
