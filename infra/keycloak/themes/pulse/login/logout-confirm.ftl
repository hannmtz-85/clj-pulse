<#import "template.ftl" as layout>
<@layout.registrationLayout; section><#if section = "header">${msg("logoutConfirmTitle")}<#elseif section = "subtitle">${msg("logoutConfirmHeader")}<#elseif section = "form"><div class="flex flex-col gap-3" id="kc-logout-confirm"><form action="${url.logoutConfirmAction}" class="flex flex-col" method="POST" onsubmit="confirmLogout.disabled = true; return true;"><input name="session_code" type="hidden" value="${logoutConfirm.code}"><button class="btn btn-primary btn-lg btn-block" id="kc-logout" name="confirmLogout" type="submit">${msg("doLogout")}</button></form><#if !logoutConfirm.skipLink && (client.baseUrl)?has_content><a class="btn btn-ghost btn-lg btn-block" href="${client.baseUrl}">${msg("doStaySignedIn")}</a></#if></div></#if></@layout.registrationLayout>
