;; A configuration to read in tests: it uses every tag the apps' files use.
{:sample/server
 {:port #profile {:default 8080 :test 0}
  :host #or [#env PULSE_SAMPLE_VARIABLE_THAT_IS_NEVER_SET "localhost"]
  :limit #long #or [#env PULSE_SAMPLE_VARIABLE_THAT_IS_NEVER_SET 25]
  :level #keyword #or [#env PULSE_SAMPLE_VARIABLE_THAT_IS_NEVER_SET "info"]
  :origins #csv #or [#env PULSE_SAMPLE_VARIABLE_THAT_IS_NEVER_SET " http://a.test , http://b.test,, "]
  :nobody #csv #or [#env PULSE_SAMPLE_VARIABLE_THAT_IS_NEVER_SET ""]
  :same-host #ref [:sample/server :host]}

 :sample/client
 {:server #ig/ref :sample/server}

 ;; a secret is read as a Secret; a variable that is not set gives no secret at all
 :sample/auth
 {:secret #secret #or [#env PULSE_SAMPLE_SECRET_THAT_IS_NEVER_SET "s3cret-value"]
  :unset #secret #env PULSE_SAMPLE_SECRET_THAT_IS_NEVER_SET}}
