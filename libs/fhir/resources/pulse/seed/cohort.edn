             {:signal :heart-rate :slots [8 20] :channel {:baseline 64 :sd 4}}
             {:signal :weight :slots [8] :channel {:baseline 78.0 :sd 0.3 :decimals 1}}]}

  ;; R4: rapid weight gain over the last 4 days (heart failure)
