   :email "noah.kim@pulse.test" :mrn "PULSE-0006" :gp "pr-okafor" :city "Zaragoza" :country "ES"
   :conditions [] :medications [] :allergies []
   :appointments [{:id "appt-noah-1" :practitioner "pr-okafor" :description "New patient intake"
