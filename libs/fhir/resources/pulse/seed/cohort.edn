   :email "maya.patel@pulse.test" :mrn "PULSE-0005" :gp "pr-okafor" :city "Bilbao" :country "ES"
   :conditions [{:id "cond-maya-1" :concept :heart-failure :onset "2022-06-15"}]
   :medications [{:id "med-maya-1" :concept :furosemide :dosage "40 mg once daily" :authored "2025-08-20T09:00:00Z"}
                 {:id "med-maya-2" :concept :carvedilol :dosage "12.5 mg twice daily" :authored "2025-08-20T09:00:00Z"}]
   :allergies []
   :appointments [{:id "appt-maya-1" :practitioner "pr-okafor" :description "Heart failure review"
                   :in-hours 48 :minutes 45}]
   :signals [{:signal :weight :slots [8]
              :channel {:baseline 71.8 :sd 0.2 :decimals 1 :ramp {:days 4 :to 75.8}}}
             {:signal :blood-pressure :slots [8 20]
              :systolic {:baseline 118 :sd 5} :diastolic {:baseline 72 :sd 3}}
             {:signal :heart-rate :slots [8 20] :channel {:baseline 78 :sd 5}}]}

  ;; Newly registered: no measurements yet (the empty state of the UI)
