{
  "name": "pulse-design",
  "private": true,
  "description": "Build tooling for the Pulse design system: Tailwind CSS and daisyUI compile the theme, the Inter font, the Lucide icons and htmx are copied from their packages (ADR-0026, ADR-0028). Development only; nothing here is deployed.",
  "scripts": {
    "css": "tailwindcss -i css/input.css -o dist/pulse.css",
    "css:min": "tailwindcss -i css/input.css -o dist/pulse.min.css --minify",
    "css:keycloak": "tailwindcss -i css/keycloak.css -o ../infra/keycloak/themes/pulse/login/resources/pulse.css --minify",
    "css:web": "tailwindcss -i css/web.css -o ../apps/web/resources/public/pulse.css --minify"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "daisyui": "5.7.50",
    "htmx.org": "2.0.11",
    "lucide-static": "1.58.0",
    "tailwindcss": "4.3.3"
  }
}
