;; Root deps.edn: tooling aliases for the whole monorepo.
;; Each lib/app has its own deps.edn and is pulled in through :local/root.
{:paths []
 :deps {}
 :aliases
 {;; Everything on one classpath, for a single REPL (apps are added as they appear).
  :dev {:extra-paths ["dev/repl" "dev/src"]
        :extra-deps {pulse/fhir {:local/root "libs/fhir"}
                     pulse/platform {:local/root "libs/platform"}
                     pulse/view {:local/root "libs/view"}
                     pulse/api {:local/root "apps/api"}
                     pulse/scheduler {:local/root "apps/scheduler"}
                     pulse/web {:local/root "apps/web"}
                     pulse/spa {:local/root "apps/spa"}
                     integrant/repl {:mvn/version "0.5.1"}
                     nrepl/nrepl {:mvn/version "1.8.0"}
                     cider/cider-nrepl {:mvn/version "0.63.1"}}}

  ;; clojure -M:test [kaocha args]    (config: tests.edn)
  ;; `test-support` holds test-only helpers shared by several suites, such as the fake
  ;; identity provider, the api's handler harness and the scheduler's fake time.
  :test {:extra-paths ["libs/platform/test-support" "apps/api/test-support" "apps/scheduler/test-support" "apps/web/test-support" "libs/ui/test-support" "dev/src" "tools" "design/src"]
         :extra-deps {pulse/fhir {:local/root "libs/fhir"}
                      pulse/platform {:local/root "libs/platform"}
                      pulse/ui {:local/root "libs/ui"}
                      pulse/view {:local/root "libs/view"}
                      pulse/api {:local/root "apps/api"}
                      pulse/scheduler {:local/root "apps/scheduler"}
                      pulse/web {:local/root "apps/web"}
                      pulse/spa {:local/root "apps/spa"}
                      hiccup/hiccup {:mvn/version "2.0.0"}
                      ;; the templating engine of Keycloak (26.0.0 ships 2.3.32): the tests of the login theme parse and render it
                      org.freemarker/freemarker {:mvn/version "2.3.32"}
                      ;; compose.yaml read as data, so that the rules of the images and the services are tests (docker-rules-test, ADR-0030)
                      clj-commons/clj-yaml {:mvn/version "1.0.30"}
                      lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      nubank/matcher-combinators {:mvn/version "3.11.0"}}
         :main-opts ["-m" "kaocha.runner"]}

  ;; clojure -M:lint
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "libs" "apps" "tools" "dev" "design/src" "design/test" "--parallel"]}

  ;; clojure -M:fmt check | fix
  :fmt {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
        :main-opts ["-m" "cljfmt.main"]}

  ;; clojure -T:build uber :app :api    (or `bb build [app ...]`; ADR-0030)
  ;; The jars of the JVM apps. A tool has a classpath of its own: the dependencies of the apps are not on it, they are read from the
  ;; deps.edn of each app (tools/build_plan.clj), so what the alias holds is tools.build and the directory of `build.clj`.
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :paths ["tools"]
          :ns-default build}

  ;; clojure -M:spa-release   (the Dockerfile of the workspace; ADR-0030)
  ;; Puts the release of the clinical workspace together after shadow-cljs has built its script: the stylesheet, the icon and the font
  ;; are copied beside it, and the page that loads it by the name with its hash is written (pulse.design.spa/release!). `bb spa:build`
  ;; does the same under Babashka; this is the JVM's, for an image that has no Babashka.
  :spa-release {:extra-paths ["design/src" "tools"]
                :extra-deps {pulse/ui {:local/root "libs/ui"}
                             hiccup/hiccup {:mvn/version "2.0.0"}
                             metosin/malli {:mvn/version "0.20.3"}}
                :main-opts ["-e" "(require 'pulse.design.spa) (pulse.design.spa/release!)"]}}}
