;; Root deps.edn: tooling aliases for the whole monorepo.
;; Each lib/app has its own deps.edn and is pulled in through :local/root.
{:paths []
 :deps {}
 :aliases
 {;; Everything on one classpath, for a single REPL (apps are added as they appear).
  :dev {:extra-paths ["dev/repl" "dev/src"]
        :extra-deps {pulse/fhir {:local/root "libs/fhir"}
                     pulse/platform {:local/root "libs/platform"}
                     pulse/api {:local/root "apps/api"}
                     pulse/scheduler {:local/root "apps/scheduler"}
                     integrant/repl {:mvn/version "0.5.1"}
                     nrepl/nrepl {:mvn/version "1.8.0"}
                     cider/cider-nrepl {:mvn/version "0.63.1"}}}

  ;; clojure -M:test [kaocha args]    (config: tests.edn)
  ;; `test-support` holds test-only helpers shared by several suites, such as the fake
  ;; identity provider, the api's handler harness and the scheduler's fake time.
  :test {:extra-paths ["libs/platform/test-support" "apps/api/test-support" "apps/scheduler/test-support" "dev/src" "tools"]
         :extra-deps {pulse/fhir {:local/root "libs/fhir"}
                      pulse/platform {:local/root "libs/platform"}
                      pulse/api {:local/root "apps/api"}
                      pulse/scheduler {:local/root "apps/scheduler"}
                      lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      nubank/matcher-combinators {:mvn/version "3.11.0"}}
         :main-opts ["-m" "kaocha.runner"]}

  ;; clojure -M:lint
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "libs" "apps" "tools" "dev" "--parallel"]}

  ;; clojure -M:fmt check | fix
  :fmt {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
        :main-opts ["-m" "cljfmt.main"]}}}
